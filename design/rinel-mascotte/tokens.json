{
  "$description": "Rinel (ex-Bip). Valeurs de référence du design. Grille de la mascotte : 32 x 32 unités ; à 16 px, 2 unités = 1 px.",
  "mascot": {
    "name": "Rinel",
    "origin": "Herve de Rinel, chevalier de la Table Ronde et cartographe (Kaamelott) : tout rond, casque a plume, parchemin sous le bras",
    "grid": 32,
    "displaySizes": { "notchCollapsed": 16, "sessionRow": 20, "cardAndPeek": 40 },
    "geometry": {
      "body": { "circle": { "cx": 16, "cy": 19, "r": 9 } },
      "helmet": { "dome": "M7.2 17 A9 9 0 0 1 24.8 17 Z", "domeFill": "rgba(255,255,255,0.30)", "brim": { "x": 6.6, "y": 16.2, "w": 18.8, "h": 1.9, "radius": 0.95, "fill": "rgba(0,0,0,0.42)" } },
      "feet": [ { "x": 10, "y": 26.4, "w": 4.2, "h": 3.6, "radius": 1.3 }, { "x": 17.8, "y": 26.4, "w": 4.2, "h": 3.6, "radius": 1.3 } ],
      "plume": {
        "up": "M12.2 10.6 C11 5.4 14.6 1.4 21.2 1.6 C19 3.6 18.4 6.6 19.8 10.6 Z",
        "vein": { "path": "M14 9.6 C14.2 6.6 16 4.4 18.6 3.2", "stroke": 0.8, "color": "rgba(0,0,0,0.25)" },
        "laid": "M11.6 10.8 C13 8 18 7.4 22.4 9.8 C19 9.6 16 10 13.6 11.2 Z",
        "drooped": "M12.6 10.8 C10 9 7.4 9.4 5.2 12.6 C8.4 11.8 10.6 12.2 13.8 11.4 Z",
        "pivot": [16, 10], "scaleWaiting": 1.2
      },
      "arm": { "path": "M23.5 20 L27.6 15.6", "stroke": 2.8, "pivot": [23.5, 20],
               "restDeg": { "waiting": "anime", "running": 10, "ready": -14, "error": 60, "idle": 55, "neutral": "coucou" } },
      "scroll": { "rect": { "x": 25.4, "y": 12.9, "w": 6.4, "h": 3, "radius": 1.5 }, "rotateDeg": -35, "pivot": [28.6, 14.4],
                  "color": "#F1E6C8", "ends": { "color": "#CDBB8A", "r": 1.5, "cx": [25.9, 31.3], "cy": 14.4 } },
      "badge": { "cx": 26, "cy": 7.5, "r": 4.2 },
      "pivotForBodyMotion": "bas-centre (16, 28) = 50 % / 87,5 %"
    }
  },
  "color": {
    "state": {
      "waiting": "#FF5D52",
      "running": "#F5A524",
      "ready": "#3FD07F",
      "error": "#8E96A3",
      "idle": "#4A4A4E",
      "neutral": "#DAD6CF"
    },
    "badge": "#FFC93D",
    "face": "#141414",
    "faceIdle": "#161616",
    "notch": {
      "background": "#000000",
      "card": "#161616",
      "buttonSecondary": "#2A2A2A",
      "borderAlways": "#333333",
      "separator": "#1C1C1C",
      "textPrimary": "#F2F2F2",
      "textCode": "#E6E6E6",
      "textSecondary": "#A3A3A3",
      "buttonPrimary": "#F2F2F2",
      "buttonPrimaryText": "#000000",
      "waitingGlow": "rgba(255, 93, 82, 0.75)",
      "toggleOn": "#3FD07F",
      "toggleOff": "#333333",
      "hover": "rgba(255, 255, 255, 0.07)",
      "settingsSeparator": "#2A2A2A"
    }
  },
  "typography": {
    "ui": "Segoe UI Variable Text, Segoe UI",
    "mono": "Cascadia Mono, Consolas",
    "styles": {
      "cardQuestion": { "family": "ui", "size": 14, "lineHeight": 20, "weight": 600 },
      "peekSentence": { "family": "ui", "size": 13, "lineHeight": 18, "weight": 600 },
      "button": { "family": "ui", "size": 13, "lineHeight": 16, "weight": 600 },
      "secondary": { "family": "ui", "size": 12, "lineHeight": 16, "weight": 400 },
      "projectInCard": { "family": "mono", "size": 13, "lineHeight": 18, "weight": 400 },
      "projectInRow": { "family": "mono", "size": 12.5, "lineHeight": 16, "weight": 400 },
      "command": { "family": "mono", "size": 12, "lineHeight": 18, "weight": 400 },
      "alwaysButton": { "family": "ui", "size": 12, "lineHeight": 16, "weight": 400 }
    }
  },
  "notch": {
    "shoulderRadius": 8,
    "forms": {
      "line": { "width": 120, "height": 4, "bottomRadius": 2, "when": "aucune session active" },
      "collapsed": { "height": 22, "paddingX": 10, "mascotSize": 16, "gap": 6, "maxMascots": 5, "bottomRadius": 11, "clickThrough": true },
      "peek": { "width": 320, "maxWidth": 440, "widthFollowsName": true, "height": 60, "mascotSize": 40, "paddingLeft": 12, "paddingRight": 18, "gap": 12, "bottomRadius": 20, "holdMs": 4000 },
      "expanded": { "width": 440, "padding": 12, "paddingTop": 20, "dndTag": { "fontSize": 11.5, "color": "textSecondary", "position": "haut gauche" }, "rowHeightWithRecap": 48, "recap": { "fontSize": 11.5, "color": "#3FD07F" }, "subAgentLine": { "height": 24, "indent": 34, "fontSize": 12, "max": 5, "doneGreenMs": 60000 }, "settingsButton": { "width": 26, "height": 18, "bars": 3, "barWidth": 12, "barHeight": 1.5 }, "bottomRadius": 24, "cardRadius": 14, "cardPadding": 14, "rowHeight": 36, "rowMascotSize": 20, "buttonHeight": 32, "buttonRadius": 8, "commandRadius": 8 }
    }
  },
  "motion": {
    "loopFps": { "default": 15, "collapsedNotch": 8, "notchGlow": 30, "transitions": 60 },
    "waiting": {
      "breathe": { "scaleX": [1, 1.04], "scaleY": [1, 1.08], "pivot": "bas-centre", "periodMs": { "under1min": 1600, "1to3min": 1100, "over3min": 800 }, "ease": "SineEase InOut", "changeAt": "fin de cycle" },
      "arm": { "rotateDeg": [-10, 12], "pivot": [23.5, 20], "sameCycleAsBreathe": true },
      "plume": { "rotateDeg": [-8, 10], "scale": [1, 1.2], "scaleMs": 200, "ease": "BackEase Out, Amplitude 0.3", "sameCycleAsBreathe": true },
      "tremble": { "keyframesDeg": [[60, -4], [150, 4], [225, -3], [300, 0]], "everyMs": { "under3min": 6000, "over3min": 4000 } },
      "notchGlow": { "height": 2, "widthPercent": 40, "color": "waitingGlow", "sweepMs": 2400, "ease": "linear" },
      "taskbarFlashAfterMs": 300000
    },
    "running": { "translateYUnits": [0, -2], "rotateDeg": [-2, 2], "arm": { "rotateDeg": [4, -6], "halfMs": 1600 }, "plume": { "rotateDeg": [-6, 8], "halfMs": 3200 }, "periodMs": 3200, "ease": "SineEase InOut", "randomStartOffsetMs": [0, 1000] },
    "ready": {
      "hopOnce": [
        { "atMs": 90, "scaleX": 1.06, "scaleY": 0.9, "translateYUnits": 0 },
        { "atMs": 270, "scaleX": 0.96, "scaleY": 1.05, "translateYUnits": -6, "ease": "QuadraticEase Out" },
        { "atMs": 390, "scaleX": 1.08, "scaleY": 0.9, "translateYUnits": 0, "ease": "QuadraticEase In" },
        { "atMs": 510, "scaleX": 1, "scaleY": 1, "translateYUnits": 0 }
      ],
      "fadeOutAfterMs": 240000,
      "fadeOutMs": 400
    },
    "error": { "sag": { "scaleX": 1.04, "scaleY": 0.94, "ms": 250, "ease": "QuadraticEase Out" }, "badgeIn": { "ms": 200, "ease": "BackEase Out, Amplitude 0.3" }, "loop": false },
    "idle": { "plumeLayMs": 400, "ease": "SineEase InOut", "loop": false },
    "neutral": { "sameAs": "running", "plume": { "rotateDeg": [-5, 7] }, "arm": "coucou", "when": "encoche vide, Rinel salue" },
    "poke": { "oneOf": ["hop", "blink", "wave"], "blinkClosedMs": 120, "wave": { "rotateDeg": [-10, 12], "halfMs": 180, "repeat": 2 } },
    "coucou": { "rotateDeg": [-16, 12], "waves": 2, "periodMs": 3200, "keyTimesMs": [0, 256, 576, 896, 1216, 1472, 3200], "values": [0, -16, 12, -16, 12, 0, 0], "blinkAt": 0.74 },
    "stateChange": { "colorMs": 250, "faceCrossfadeMs": 150 },
    "notchTransform": {
      "open": { "ms": 500, "wpf": "BackEase EaseOut, Amplitude 0.3", "css": "cubic-bezier(0.34, 1.36, 0.64, 1)", "hoverDelayMs": 200 },
      "content": { "startMs": 200, "perLineMs": 180, "staggerMs": 40, "fromTranslateY": 4, "ease": "CubicEase Out" },
      "close": { "ms": 350, "wpf": "KeySpline 0.4,0 0.2,1", "css": "cubic-bezier(0.4, 0, 0.2, 1)", "contentFadeOutMs": 100, "leaveDelayMs": 300 },
      "peek": { "openMs": 400, "wpf": "BackEase EaseOut, Amplitude 0.2", "holdMs": 4000, "closeMs": 350 }
    }
  }
}
